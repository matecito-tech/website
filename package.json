{
  "name": "matecito-website",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Matecito Tech: páginas web, tiendas online y software a medida desde Humboldt, Santa Fe",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:bg": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs --follow",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:js": "eslint src/scripts/*.js",
    "validate:html": "html-validate \"dist/**/*.html\" \"public/**/*.html\"",
    "contrast": "node scripts/contrast.mjs",
    "test:e2e": "playwright test",
    "test": "bun run validate:html && bun run lint:js && bun run check && bun run contrast"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "apca-w3": "^0.1.9",
    "astro": "^7.4.2",
    "culori": "^4.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4"
  }
}
