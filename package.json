{
  "name": "matecito-website",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Matecito - Desarrollo de Software Artesanal",
  "scripts": {
    "validate:html": "html-validate \"*.html\"",
    "lint:js": "eslint js/*.js",
    "test": "npm run validate:html && npm run lint:js",
    "serve": "python3 -m http.server 8080",
    "build": "postcss css/input.css -o css/output.css",
    "dev": "postcss css/input.css -o css/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.0.0",
    "globals": "^17.8.0",
    "html-validate": "^8.0.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.3.3"
  }
}
