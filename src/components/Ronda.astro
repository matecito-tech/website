---
// "La ronda de mate": gamificación liviana. Se ceba un mate por cada logro
// (explorar secciones clave, cebarle un mate al gaucho, charlar con el
// asistente). Completar la ronda desbloquea un diagnóstico sin cargo.
// El progreso se guarda solo en este navegador (localStorage).
import { whatsappLink } from '../data/site';

export const LOGROS = [
  { id: 'historia', label: 'Conociste nuestra historia', hint: 'Leé "Una historia que seguro conocés".' },
  { id: 'casos', label: 'Viste un proyecto real', hint: 'Pasá por el caso de Schalbetter.' },
  { id: 'precios', label: 'Miraste los precios', hint: 'Están todos publicados.' },
  { id: 'gaucho', label: 'Le cebaste un mate al gaucho', hint: 'Tocá el mate del gaucho, arriba de todo.' },
  { id: 'asistente', label: 'Charlaste con el asistente', hint: 'Hacele una pregunta.' },
];
const premio = whatsappLink('¡Hola Matecito Tech! Completé la ronda de mate en la web y quiero mi diagnóstico sin cargo.');
---
<div class="dock" data-dock>
  <button type="button" class="ronda-pill" popovertarget="ronda" data-ronda-pill>
    <span class="ronda-mate" aria-hidden="true">
      <svg viewBox="0 0 430 564"><defs><clipPath id="ronda-clip"><rect data-ronda-fill x="0" y="564" width="430" height="564"/></clipPath></defs>
        <path d="M264 170c12-50 36-100 80-130 20-13 40-24 56-30" fill="none" stroke="currentColor" stroke-width="34" stroke-linecap="round"/>
        <path d="M44 244h341c22 34 27 82 27 134 0 104-87 186-198 186S2 482 2 378c0-52 20-100 42-134z" fill="none" stroke="currentColor" stroke-width="34"/>
        <path d="M44 244h341c22 34 27 82 27 134 0 104-87 186-198 186S2 482 2 378c0-52 20-100 42-134z" fill="currentColor" clip-path="url(#ronda-clip)"/>
        <path d="M72 176h258q6 0 9 6l15 33q4 10-7 10H55q-11 0-7-10l15-33q3-6 9-6z" fill="currentColor"/>
      </svg>
    </span>
    <span class="ronda-pill__txt"><span class="ronda-pill__label">Ronda de mate</span> <strong data-ronda-count>0/5</strong><span class="sr-only"> mates cebados</span></span>
  </button>
  <button type="button" class="dock__btn" data-chat-open aria-controls="chat" aria-expanded="false">
    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chat_bubble"/></svg>Asistente
  </button>
  <a href="/#contacto" class="dock__cta">Pedí presupuesto</a>
  <a href="/arrepentimiento/" class="dock__legal">Botón de arrepentimiento</a>
</div>

<div id="ronda" popover role="dialog" class="ronda-pop" aria-labelledby="ronda-titulo">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 id="ronda-titulo" class="font-display font-bold text-xl">La ronda de mate</h2>
      <p class="text-sm text-[var(--ink-2)] mt-1">Cebá los 5 mates recorriendo el sitio. Al completar la ronda te ganás un <strong class="text-[var(--color-foreground)]">diagnóstico sin cargo</strong> de tu web o tus redes.</p>
    </div>
    <button type="button" class="chat__close" popovertarget="ronda" popovertargetaction="hide" aria-label="Cerrar la ronda">
      <svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <div class="ronda-bar" role="progressbar" aria-label="Progreso de la ronda" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0" data-ronda-bar><span></span></div>
  <ul class="ronda-list">
    {LOGROS.map((l) => (
      <li data-logro={l.id}>
        <span class="ronda-check" aria-hidden="true"><svg class="icon"><use href="#i-check"/></svg></span>
        <span><span class="block font-semibold">{l.label}</span><span class="block text-xs text-[var(--ink-2)]">{l.hint}</span></span>
        <span class="sr-only" data-logro-state>pendiente</span>
      </li>
    ))}
  </ul>
  <div class="ronda-premio" data-ronda-premio hidden>
    <p class="font-display font-bold text-lg">¡Ronda completa!</p>
    <p class="text-sm mb-3">Te ganaste un diagnóstico sin cargo: revisamos tu web o tus redes y te decimos qué mejorar.</p>
    <a class="btn-cta w-full justify-center" href={premio} target="_blank" rel="noopener">Pedir mi diagnóstico por WhatsApp</a>
  </div>
</div>

<style is:global>
  /* ---------- Dock: pill flotante en escritorio, barra inferior en mobile ---------- */
  .dock { position: fixed; left: 1rem; bottom: 1rem; z-index: 55; display: flex; gap: .5rem; align-items: center; pointer-events: none; }
  .dock > * { pointer-events: auto; }
  .dock__btn, .dock__cta { display: none; }
  /* Res. SCI 424/2020: acceso permanente y visible desde la primera pantalla */
  .dock__legal { font-size: .75rem; padding: .35rem .7rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--hair);
                 color: var(--ink-2); text-decoration: underline; text-underline-offset: 2px; }
  .dock__legal:hover { color: var(--color-foreground); }
  .ronda-pill {
    display: inline-flex; align-items: center; gap: .55rem; min-height: 2.75rem; padding: .35rem .95rem .35rem .45rem; border-radius: 999px;
    background: var(--surface); color: var(--color-foreground); border: 1px solid var(--hair); font-size: .875rem;
    box-shadow: 0 14px 32px -18px rgb(0 0 0 / .45); transition: transform .2s var(--ease-out-soft), border-color .2s ease;
  }
  .ronda-pill:hover { border-color: var(--color-brand-verde); transform: translateY(-1px); }
  .ronda-pill.is-pop { animation: pop .6s var(--ease-out-soft); }
  @keyframes pop { 30% { transform: scale(1.12); } }
  .ronda-mate { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 999px; color: var(--color-brand-verde);
                background: color-mix(in oklch, var(--color-brand-verde) 12%, transparent); }
  :root.dark .ronda-mate { color: var(--color-brand-verde-400); }
  .ronda-mate svg { width: 1.05rem; height: 1.35rem; overflow: visible; shape-rendering: geometricPrecision; }
  .ronda-mate rect { transition: y .8s var(--ease-out-soft); }

  @media (max-width: 1023px) {
    .dock {
      left: 0; right: 0; bottom: 0; gap: .4rem; padding: .5rem .75rem calc(.5rem + env(safe-area-inset-bottom));
      background: var(--glass-bg); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
      border-top: 1px solid var(--hair); pointer-events: auto;
      translate: 0 110%; transition: translate .45s var(--ease-out-soft);
    }
    .dock.is-ready { translate: 0 0; }
    .ronda-pill { box-shadow: none; padding-right: .7rem; }
    .ronda-pill__label { display: none; }
    .dock__btn, .dock__cta { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 2.75rem; border-radius: .85rem; font-weight: 700; font-size: .9rem; }
    .dock__btn { padding: 0 .8rem; border: 1px solid var(--hair); background: var(--surface); }
    .dock__cta { flex: 1; background: var(--color-brand-verde); color: #fff; }
    .chat-fab { display: none !important; }
    .dock__legal { display: none; }
    /* El contenido no queda tapado por la barra */
    body { padding-bottom: calc(4rem + env(safe-area-inset-bottom)); }
    #toast-container { bottom: calc(5rem + env(safe-area-inset-bottom)); }
    .chat { bottom: calc(.75rem + env(safe-area-inset-bottom)); }
  }

  /* ---------- Panel (popover nativo) ---------- */
  .ronda-pop {
    margin: auto auto 5.25rem 1rem; width: min(24rem, calc(100vw - 2rem)); padding: 1.25rem; border-radius: 1.25rem;
    border: 1px solid var(--hair); background: var(--color-background); color: var(--color-foreground);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / .55);
  }
  @media (max-width: 1023px) { .ronda-pop { margin: auto auto calc(4.75rem + env(safe-area-inset-bottom)) .75rem; } }
  .ronda-pop::backdrop { background: rgb(0 0 0 / .15); }
  .ronda-pop:popover-open { animation: chat-in .3s var(--ease-out-soft); }
  .ronda-bar { height: .5rem; border-radius: 999px; background: var(--hair); margin: 1rem 0; overflow: hidden; }
  .ronda-bar span { display: block; height: 100%; width: var(--p, 0%); background: linear-gradient(90deg, var(--color-brand-verde), var(--color-brand-sol)); border-radius: inherit; transition: width .8s var(--ease-out-soft); }
  .ronda-list { display: grid; gap: .75rem; }
  .ronda-list li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .75rem; align-items: start; font-size: .9rem; }
  .ronda-check { width: 1.5rem; height: 1.5rem; border-radius: 999px; display: grid; place-items: center; border: 2px solid var(--hair); color: transparent; margin-top: .1rem; transition: all .3s ease; }
  .ronda-list li.is-done .ronda-check { background: var(--color-brand-verde); border-color: var(--color-brand-verde); color: #fff; }
  .ronda-list li.is-done .font-semibold { text-decoration: line-through; text-decoration-color: color-mix(in oklch, currentColor 40%, transparent); }
  .ronda-premio { margin-top: 1.25rem; padding: 1rem; border-radius: 1rem; background: color-mix(in oklch, var(--color-brand-sol) 22%, transparent); border: 1px solid color-mix(in oklch, var(--color-brand-sol) 55%, transparent); }

  /* Botón invisible sobre el mate del gaucho + bocanada de festejo */
  .cebar { position: absolute; z-index: 3; left: 52%; top: 38%; width: 34%; height: 24%; border-radius: 40%; cursor: pointer; }
  .cebar:focus-visible { outline-offset: 0; }
  .cebar__puf { position: absolute; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: #FFFFB3; pointer-events: none;
                animation: cebar-puf 1.1s ease-out forwards; }
  .cebar__plus { position: absolute; pointer-events: none; font-family: var(--font-display); font-weight: 700; color: var(--color-brand-verde);
                 background: #fff; padding: .15rem .5rem; border-radius: 999px; font-size: .85rem; box-shadow: 0 6px 16px -8px rgb(0 0 0 / .4);
                 animation: cebar-plus 1.3s var(--ease-out-soft) forwards; }
  @keyframes cebar-puf { from { opacity: .9; transform: translate(0, 0) scale(.5); } to { opacity: 0; transform: translate(var(--dx), -5rem) scale(2.2); } }
  @keyframes cebar-plus { from { opacity: 0; transform: translateY(0); } 20% { opacity: 1; } to { opacity: 0; transform: translateY(-3.5rem); } }
</style>
