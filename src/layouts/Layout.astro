---
import '../styles/global.css';
import '../styles/gaucho-animation.css';
import IconSprite from '../components/IconSprite.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth snap-y snap-proximity scroll-pt-20 overflow-x-clip">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#00704A">

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title}>
    <meta name="description" content={description}>
    <meta name="keywords" content="desarrollo software humboldt, diseño web santa fe, ecommerce rafaela, programador argentina, matecito tech, automatizacion negocios, sistemas a medida, mateo gariboglio">
    <meta name="author" content="Mateo Gariboglio">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <link rel="canonical" href="https://matecito.qzz.io/">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://matecito.qzz.io/">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://matecito.qzz.io/public/Matecito-logo.svg">
    <meta property="og:locale" content="es_AR">
    <meta property="og:site_name" content="Matecito Tech">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://matecito.qzz.io/">
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content="https://matecito.qzz.io/public/Matecito-logo.svg">
    <meta name="twitter:creator" content="@Mateo_404">

    <!-- Google Fonts (Performance Optimized) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <!-- Preload Critical Resources -->
    <link rel="preload" href="/Matecito-logo-light.svg" as="image">
    <link rel="preload" href="/gaucho.svg" as="image">

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Matecito Tech",
      "image": "https://matecito.qzz.io/public/Matecito-logo.svg",
      "telephone": "+543425370985",
      "email": "matecito.tech@gmail.com",
      "url": "https://matecito.qzz.io",
      "logo": "https://matecito.qzz.io/public/Matecito-logo.svg",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Humboldt",
        "addressRegion": "Santa Fe",
        "postalCode": "3081",
        "addressCountry": "AR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -31.4000,
        "longitude": -61.0833
      },
      "sameAs": [
        "https://www.linkedin.com/in/mateo-gariboglio",
        "https://github.com/Mateo-404"
      ],
      "founder": {
        "@type": "Person",
        "name": "Mateo Gariboglio"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      },
      "description": "Desarrollo de software a medida, diseño web profesional y e-commerce en Humboldt y Santa Fe."
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Matecito | Desarrollo de Software",
      "url": "https://matecito.qzz.io",
      "serviceType": "Desarrollo de Software a Medida",
      "knowsAbout": ["Desarrollo Web", "E-commerce", "SEO", "Sistemas de Gestión", "Automatización", "Java", "Spring Boot", "React"],
      "areaServed": ["Humboldt", "Rafaela", "Esperanza", "Santa Fe", "Argentina"]
    }
    </script>

    <!-- Theme Color Script (inline to prevent FOUC) -->
    <script>
      (function() {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (!theme && prefersDark);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>

    <link rel="preload" as="font" href="/fonts/Manrope-VariableFont_wght.ttf" type="font/ttf" crossorigin>
    <link rel="preload" as="font" href="/fonts/SpaceGrotesk-VariableFont_wght.ttf" type="font/ttf" crossorigin>
    <link rel="preload" as="font" href="/fonts/JetBrainsMono-Regular.ttf" type="font/ttf" crossorigin>
</head>
<body class="bg-brand-crema text-brand-dark antialiased selection:bg-brand-verde selection:text-white overflow-x-hidden font-sans">
    <!-- Skip link para navegación por teclado -->
    <a href="#main" class="skip-link">Saltar al contenido principal</a>

    <!-- NAVBAR -->
    <nav class="fixed w-full z-50 glass-card border-b border-brand-verde-profundo/5 top-0 transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2 group">
                <img src="/Matecito-logo-light.svg" alt="Matecito Logo" loading="eager" class="w-10 h-10 transition-transform duration-300 group-hover:scale-110">
                <span class="font-display font-bold text-xl tracking-tight text-brand-dark">Matecito</span>
            </a>

            <div class="hidden lg:flex items-center gap-8 font-medium text-sm text-brand-verde-profundo/80">
                <a href="#filosofia" class="hover:text-brand-verde transition-colors">Nosotros</a>
                <a href="#servicios" class="hover:text-brand-verde transition-colors">Servicios</a>
                <a href="#metodologia" class="hover:text-brand-verde transition-colors">Cómo Trabajamos</a>
                <a href="#equipo" class="hover:text-brand-verde transition-colors">El Equipo</a>
                <a href="#casos" class="hover:text-brand-verde transition-colors">Casos</a>
                <a href="#contacto" class="bg-brand-verde text-white px-5 py-2.5 rounded-full hover:bg-brand-verde-700 transition-all hover:scale-105 shadow-lg shadow-brand-verde/20 font-bold flex items-center gap-2">
                    <svg class="icon text-sm" width="1em" height="1em"><use href="#i-chat_bubble"/></svg>
                    Hablemos
                </a>
            </div>
            <div class="flex items-center gap-1">
                <!-- Theme toggle: auto / claro / oscuro -->
                <div class="hidden sm:flex items-center gap-1 mr-2" role="group" aria-label="Tema de color">
                    <button type="button" data-theme-toggle="auto" aria-pressed="true" class="w-8 h-8 rounded-full flex items-center justify-center text-brand-verde-profundo/70 hover:text-brand-verde hover:bg-brand-verde/10 transition-colors" title="Automático">
                        <svg class="icon text-lg" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-bolt"/></svg>
                        <span class="sr-only">Tema automático</span>
                    </button>
                    <button type="button" data-theme-toggle="light" aria-pressed="false" class="w-8 h-8 rounded-full flex items-center justify-center text-brand-verde-profundo/70 hover:text-brand-verde hover:bg-brand-verde/10 transition-colors" title="Claro">
                        <svg class="icon text-lg" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-visibility"/></svg>
                        <span class="sr-only">Tema claro</span>
                    </button>
                    <button type="button" data-theme-toggle="dark" aria-pressed="false" class="w-8 h-8 rounded-full flex items-center justify-center text-brand-verde-profundo/70 hover:text-brand-verde hover:bg-brand-verde/10 transition-colors" title="Oscuro">
                        <svg class="icon text-lg" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-work"/></svg>
                        <span class="sr-only">Tema oscuro</span>
                    </button>
                </div>
                <!-- Mobile Menu Icon -->
                <button type="button" class="lg:hidden text-brand-verde-profundo" aria-label="Menú" aria-expanded="false" aria-controls="mobile-menu">
                    <svg class="icon text-3xl" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-menu"/></svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden absolute top-full left-0 right-0 bg-brand-crema border-b border-brand-verde-profundo/5 p-6 hidden z-40 flex flex-col gap-4 overflow-clip">
        <a href="#filosofia" class="block py-2 text-brand-verde-profundo/80 hover:text-brand-verde transition-colors">Nosotros</a>
        <a href="#servicios" class="block py-2 text-brand-verde-profundo/80 hover:text-brand-verde transition-colors">Servicios</a>
        <a href="#metodologia" class="block py-2 text-brand-verde-profundo/80 hover:text-brand-verde transition-colors">Cómo Trabajamos</a>
        <a href="#equipo" class="block py-2 text-brand-verde-profundo/80 hover:text-brand-verde transition-colors">El Equipo</a>
        <a href="#casos" class="block py-2 text-brand-verde-profundo/80 hover:text-brand-verde transition-colors">Casos</a>
        <a href="#contacto" class="block py-2 bg-brand-verde text-white px-4 rounded-xl font-bold text-center hover:bg-brand-verde-700 transition-all shadow-lg shadow-brand-verde/20">Hablemos</a>
    </div>

    <main id="main" class="pt-20">
        <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-brand-dark text-white py-12 border-t border-white/5">
        <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-4 gap-12 text-sm">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-3 mb-4 text-white">
                    <img src="/Matecito-logo.svg" alt="Matecito Logo" loading="lazy" class="w-8 h-8">
                    <span class="font-display font-bold text-xl">Matecito</span>
                </div>
                <p class="max-w-xs mb-6">Ingeniería de software con raíces santafesinas. Desarrollamos el futuro sin olvidar de dónde venimos.</p>
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 rounded-full text-xs text-brand-verde border border-brand-verde/20">
                    <span class="w-2 h-2 bg-brand-verde rounded-full animate-pulse"></span> En Linea
                </div>
            </div>

            <div>
                <h4 class="font-bold text-white mb-4 uppercase tracking-wider text-xs">Navegación</h4>
                <ul class="space-y-3">
                    <li><a href="/" class="hover:text-brand-verde transition-colors">Inicio</a></li>
                    <li><a href="#filosofia" class="hover:text-brand-verde transition-colors">Nosotros</a></li>
                    <li><a href="#servicios" class="hover:text-brand-verde transition-colors">Servicios</a></li>
                    <li><a href="#equipo" class="hover:text-brand-verde transition-colors">Equipo</a></li>
                    <li><a href="#casos" class="hover:text-brand-verde transition-colors">Casos</a></li>
                </ul>
            </div>

            <div>
                <h4 class="font-bold text-white mb-4 uppercase tracking-wider text-xs">Conectemos</h4>
                <p class="mb-2">Humboldt, Santa Fe, AR</p>
                <a href="mailto:matecito.tech@gmail.com" class="hover:text-brand-verde transition-colors block mb-2 font-medium text-white">matecito.tech@gmail.com</a>
                <div class="flex flex-col gap-2 mt-2">
                    <a href="https://www.linkedin.com/company/matecito-tech" target="_blank" class="hover:text-brand-verde transition-colors flex items-center gap-2 text-white"><svg class="icon text-sm" width="1em" height="1em"><use href="#i-work"/></svg> LinkedIn</a>
                    <a href="https://github.com/matecito-tech" target="_blank" class="hover:text-brand-verde transition-colors flex items-center gap-2 text-white"><svg class="icon text-sm" width="1em" height="1em"><use href="#i-code"/></svg> GitHub</a>
                    <a href="https://www.instagram.com/matecito.tech/" target="_blank" class="hover:text-brand-verde transition-colors flex items-center gap-2 text-white"><svg class="icon text-sm" width="1em" height="1em"><use href="#i-photo_camera"/></svg> Instagram</a>
                </div>
                <div class="mt-6">
                    <h4 class="font-bold text-white mb-4 uppercase tracking-wider text-xs">Legal</h4>
                    <ul class="space-y-3">
                        <li><a href="/arrepentimiento" class="hover:text-brand-verde transition-colors">Privacidad</a></li>
                        <li><a href="/terminos" class="hover:text-brand-verde transition-colors">Términos</a></li>
                        <li><a href="/arrepentimiento" class="text-brand-verde hover:brightness-110 transition-all font-medium">Arrepentimiento</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 mt-12 pt-8 border-t border-white/5 text-xs flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 text-center md:text-left">
                <span>&copy; 2026 Matecito. Hecho con ❤️ y 🧉 en Argentina.</span>
                <span class="hidden md:inline opacity-20">|</span>
                <span class="opacity-60">Ilustración Gaucho por <a href="https://www.freepik.com" target="_blank" class="hover:text-brand-verde transition-colors underline decoration-white/10" title="Dibujado a mano ilustración gaucho bebiendo">Freepik</a></span>
            </div>

            <div class="flex items-center gap-6">
                <a href="#" id="afip-data-fiscal" class="opacity-50 hover:opacity-100 transition-opacity" title="Data Fiscal AFIP">
                    <div class="w-8 h-10 bg-white/10 rounded flex items-center justify-center border border-white/5">
                        <svg class="icon text-lg" width="1em" height="1em"><use href="#i-qr_code_2"/></svg>
                    </div>
                </a>
                <span class="opacity-70 hover:opacity-100 transition-opacity cursor-pointer">v3.2.0-FOGON</span>
            </div>
        </div>
    </footer>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <!-- Sprite de iconos SVG -->
    <IconSprite />

    <!-- Theme Toggle Script -->
    <script>
      (function() {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (!theme && prefersDark);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>

    <!-- Scripts -->
    <script>
        import '../scripts/main.js';
        import '../scripts/gaucho-animator.js';
    </script>
</body>
</html>