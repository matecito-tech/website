---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import Logo from '../components/Logo.astro';
import { Font } from 'astro:assets';
import Assistant from '../components/Assistant.astro';
import Ronda from '../components/Ronda.astro';
import { BUSINESS, SITE_URL, whatsappLink } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Nombre de la página para el BreadcrumbList (las páginas internas). */
  breadcrumb?: string;
  /** Nodos JSON-LD extra de la página (se suman al @graph del sitio). */
  schema?: Record<string, unknown>[];
}
const { title, description, noindex = false, breadcrumb, schema = [] } = Astro.props;

const SITE = SITE_URL;
const canonicalURL = new URL(Astro.url.pathname, SITE).toString();
const ogImageURL = `${SITE}/og-image.png`;
const isHome = Astro.url.pathname === '/';

// Grafo de entidades: una sola organización con @id estable, referenciada
// desde el WebSite (nombre del sitio en Google) y desde cada WebPage.
const ORG_ID = `${SITE}/#organizacion`;
const graph = [
  {
    '@type': ['ProfessionalService', 'Organization'],
    '@id': ORG_ID,
    name: 'Matecito Tech',
    alternateName: ['Matecito', 'Matecito Software', 'matecito.tech'],
    legalName: 'Matecito Tech',
    slogan: 'Software artesanal desde Humboldt, Santa Fe',
    description: 'Estudio de desarrollo de software de Humboldt, Santa Fe (Argentina): sitios web, tiendas online, sistemas de gestión a medida y mantenimiento para pymes y emprendedores.',
    url: `${SITE}/`,
    logo: { '@type': 'ImageObject', url: `${SITE}/logo-512.png`, width: 512, height: 512 },
    image: ogImageURL,
    email: 'matecito.tech@gmail.com',
    telephone: '+54 342 537-0985',
    priceRange: 'USD 50 – USD 550',
    currenciesAccepted: 'ARS, USD',
    foundingDate: '2025',
    founder: { '@id': `${SITE}/#mateo-gariboglio` },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Humboldt',
      addressRegion: 'Santa Fe',
      postalCode: '3081',
      addressCountry: 'AR',
    },
    geo: { '@type': 'GeoCoordinates', latitude: -31.4, longitude: -61.0833 },
    areaServed: [
      { '@type': 'City', name: 'Humboldt' },
      { '@type': 'City', name: 'Rafaela' },
      { '@type': 'City', name: 'Esperanza' },
      { '@type': 'City', name: 'Santa Fe' },
      { '@type': 'Country', name: 'Argentina' },
    ],
    knowsAbout: ['Desarrollo web', 'Páginas web', 'E-commerce', 'SEO', 'Sistemas de gestión', 'Automatización de procesos', 'Java', 'Spring Boot', 'PostgreSQL', 'Docker'],
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'matecito.tech@gmail.com',
      telephone: '+54 342 537-0985',
      availableLanguage: ['es'],
      areaServed: 'AR',
    },
    sameAs: [
      'https://www.instagram.com/matecito.tech/',
      'https://www.linkedin.com/company/matecito-tech',
      'https://github.com/matecito-tech',
    ],
  },
  {
    '@type': 'Person',
    '@id': `${SITE}/#mateo-gariboglio`,
    name: 'Mateo Gariboglio',
    jobTitle: 'Fundador y Scrum Master',
    worksFor: { '@id': ORG_ID },
    sameAs: ['https://www.linkedin.com/in/mateo-gariboglio/', 'https://github.com/Mateo-404'],
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#sitio`,
    name: 'Matecito Tech',
    alternateName: ['Matecito', 'matecito.qzz.io'],
    url: `${SITE}/`,
    inLanguage: 'es-AR',
    publisher: { '@id': ORG_ID },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonicalURL}#pagina`,
    url: canonicalURL,
    name: title,
    description,
    inLanguage: 'es-AR',
    isPartOf: { '@id': `${SITE}/#sitio` },
    about: { '@id': ORG_ID },
    ...(isHome ? { primaryImageOfPage: ogImageURL } : {}),
  },
  ...(breadcrumb
    ? [{
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Matecito Tech', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonicalURL },
        ],
      }]
    : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const nav = [
  { href: '/#historia', label: 'Por qué' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#casos', label: 'Casos' },
  { href: '/#proceso', label: 'Cómo trabajamos' },
  { href: '/#precios', label: 'Precios' },
  { href: '/#nosotros', label: 'Nosotros' },
];
---

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#FDFBF7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1A120E" media="(prefers-color-scheme: dark)">

    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Matecito Tech">
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}>
    <link rel="canonical" href={canonicalURL}>
    <link rel="alternate" hreflang="es-AR" href={canonicalURL}>
    <link rel="alternate" hreflang="x-default" href={canonicalURL}>

    <!-- Íconos: Google muestra el favicon en los resultados (múltiplo de 48 px) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Matecito Tech">
    <meta property="og:locale" content="es_AR">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageURL}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Matecito Tech: un gaucho tomando mate junto al logo, software a medida desde Humboldt, Santa Fe">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageURL}>

    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Tema antes del primer pintado (evita el parpadeo) -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) { t = null; }
        var dark = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.dataset.theme = t || 'auto';
        document.documentElement.classList.add('js');
      })();
    </script>
</head>
<body class="bg-brand-crema dark:bg-brand-dark text-brand-dark dark:text-brand-crema antialiased selection:bg-brand-verde selection:text-white font-sans">
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <header class="site-nav" id="navbar">
        <nav class="wrap h-16 lg:h-20 flex items-center justify-between gap-6" aria-label="Principal">
            <a href="/" class="brand">
                <Logo class="brand__mark" />
                <span class="brand__name">Matecito <span class="brand__tech">Tech</span></span>
            </a>

            <ul class="hidden lg:flex items-center gap-1 text-sm font-medium">
                {nav.map((item) => (
                  <li><a href={item.href} class="nav-link" data-nav-link>{item.label}</a></li>
                ))}
            </ul>

            <div class="flex items-center gap-2">
                <button type="button" data-theme-toggle class="theme-toggle" aria-pressed="false" aria-label="Activar modo oscuro">
                    <svg class="w-5 h-5 dark:hidden" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg class="w-5 h-5 hidden dark:block" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v2M12 20.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1.5 12h2M20.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
                </button>
                <a href="/#contacto" class="btn-cta hidden sm:inline-flex">Pedí tu presupuesto</a>
                <button type="button" class="menu-toggle lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
                    <span aria-hidden="true"></span>
                </button>
            </div>
        </nav>

        <div id="mobile-menu" class="mobile-menu lg:hidden" hidden>
            <ul class="flex flex-col">
                {nav.map((item) => (
                  <li><a href={item.href} class="block py-3 text-lg font-medium border-b border-brand-verde-profundo/10 dark:border-white/10">{item.label}</a></li>
                ))}
            </ul>
            <a href="/#contacto" class="btn-cta justify-center mt-6 w-full">Pedí tu presupuesto</a>
            <a href="/arrepentimiento/" class="block text-center text-sm underline underline-offset-2 mt-5 text-[var(--ink-2)]">Botón de arrepentimiento</a>
        </div>
    </header>

    <main id="main" tabindex="-1">
        <slot />
    </main>

    <footer class="bg-brand-verde-profundo dark:bg-black/30 text-brand-crema snap-end">
        <div class="wrap py-16 grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr] text-sm">
            <div>
                <a href="/" class="brand brand--lg mb-5">
                    <Logo class="brand__mark" />
                    <span class="brand__name">Matecito <span class="brand__tech">Tech</span></span>
                </a>
                <p class="max-w-xs text-brand-crema/80 leading-relaxed">Estudio de software de Humboldt, Santa Fe. Sitios web, tiendas online y sistemas a medida para negocios que quieren trabajar mejor.</p>
            </div>

            <div>
                <h2 class="footer-title">Sitio</h2>
                <ul class="footer-list">
                    {nav.slice(1, 6).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                </ul>
            </div>

            <div>
                <h2 class="footer-title">Contacto</h2>
                <ul class="footer-list">
                    <li><a href="mailto:matecito.tech@gmail.com">matecito.tech@gmail.com</a></li>
                    <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
                    <li><a href="https://www.instagram.com/matecito.tech/" target="_blank" rel="noopener me">Instagram</a></li>
                    <li><a href="https://www.linkedin.com/company/matecito-tech" target="_blank" rel="noopener me">LinkedIn</a></li>
                    <li><a href="https://github.com/matecito-tech" target="_blank" rel="noopener me">GitHub</a></li>
                </ul>
            </div>

            <div>
                <h2 class="footer-title">Legal</h2>
                <ul class="footer-list">
                    <li><a href="/politica-de-privacidad/">Política de privacidad</a></li>
                    <li><a href="/terminos/">Términos y condiciones</a></li>
                    <li><a href="/arrepentimiento/">Botón de arrepentimiento</a></li>
                    <li><a href="/arrepentimiento/#baja">Botón de baja</a></li>
                </ul>
                {BUSINESS.dataFiscalUrl && (
                    <a class="inline-block mt-4" href={BUSINESS.dataFiscalUrl} target="_blank" rel="noopener" aria-label="Data Fiscal de ARCA"><img src="https://www.afip.gob.ar/images/f960/DATAWEB.jpg" width="56" height="77" alt="Data Fiscal" loading="lazy"></a>
                )}
                <p class="mt-6 text-brand-crema/70 flex items-center gap-1.5"><svg class="icon" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-pin"/></svg>Humboldt, Santa Fe, Argentina</p>
            </div>
        </div>
        <div class="wrap py-6 border-t border-white/10 text-xs text-brand-crema/70 flex flex-col md:flex-row gap-3 md:justify-between">
            <div class="grid gap-2">
                <p>© 2026 {BUSINESS.legalName || BUSINESS.name}{BUSINESS.cuit && <> · CUIT {BUSINESS.cuit}</>}{BUSINESS.address && <> · {BUSINESS.address}</>}. Hecho con mate en Argentina.</p>
                <p>Defensa de las y los Consumidores. Para reclamos <a class="underline underline-offset-2 hover:text-white" href="https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario" target="_blank" rel="noopener">ingrese aquí</a>.</p>
                <p class="flex flex-wrap gap-x-4 gap-y-1"><a class="underline underline-offset-2 hover:text-white font-semibold" href="/arrepentimiento/">Botón de arrepentimiento</a><a class="underline underline-offset-2 hover:text-white font-semibold" href="/arrepentimiento/#baja">Botón de baja</a></p>
            </div>
            <p>Ilustración del gaucho: <a class="underline underline-offset-2 hover:text-white" href="https://www.freepik.com" target="_blank" rel="noopener">Freepik</a>. Vaca, tractor y satélite: <a class="underline underline-offset-2 hover:text-white" href="https://github.com/jdecked/twemoji" target="_blank" rel="noopener">Twemoji</a> (CC-BY 4.0), recoloreados.</p>
        </div>
    </footer>

    <Ronda />
    <Assistant />

    <div id="toast-container" role="status" aria-live="polite"></div>

    <IconSprite />

    <script>
        import '../scripts/main.js';
    </script>
</body>
</html>
