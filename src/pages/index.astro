---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { Image } from 'astro:assets';
import mateoImg from '../assets/hero/mateo-gariboglio_low-poly.webp';
import schalbetterImg from '../assets/schalbetter-logo.webp';
import gauchoImg from '../assets/hero/gaucho.svg';
import solImg from '../assets/hero/sol.svg';
import lunaImg from '../assets/hero/luna.svg';
import campoImg from '../assets/hero/tech/campo-tech.svg';
import campoNocheImg from '../assets/hero/tech/campo-tech-noche.svg';
import primerPlanoImg from '../assets/hero/primer-plano.svg';
import primerPlanoNocheImg from '../assets/hero/primer-plano-noche.svg';
import redNodosDia from '../assets/hero/tech/red-nodos-dia.svg';
import redNodosNoche from '../assets/hero/tech/red-nodos-noche.svg';
import sateliteDia from '../assets/hero/tech/satelite-dia.svg';
import sateliteNoche from '../assets/hero/tech/satelite-noche.svg';
import dronDia from '../assets/hero/tech/dron-dia.svg';
import dronNoche from '../assets/hero/tech/dron-noche.svg';
import torreDia from '../assets/hero/tech/torre-senal-dia.svg';
import torreNoche from '../assets/hero/tech/torre-senal-noche.svg';
---
<Layout title="Matecito | Desarrollo de Software Artesanal | Humboldt, Santa Fe" description="Impulsá tu negocio con desarrollo de software artesanal en Humboldt y Santa Fe. Sitios web de alto impacto, tiendas online y sistemas a medida que venden solos.">
    <header class="hero" id="hero">
      <!-- z0 · puntitos / estrellas -->
      <div class="hero__dust" id="dust" aria-hidden="true" data-dx="4" data-dy="3">
        <div class="shoot"></div>
      </div>
      <div class="crux" id="crux" aria-hidden="true" data-dx="4" data-dy="3"></div>

      <!-- TECH · red de nodos (z0) y satélite (animado) -->
      <Image class="hero__tech hero__tech--net hero__tech--net--dia" src={redNodosDia} alt="" width={900} height={340} decoding="async" data-dx="5" data-dy="3" />
      <Image class="hero__tech hero__tech--net hero__tech--net--noche" src={redNodosNoche} alt="" width={900} height={340} decoding="async" loading="lazy" data-dx="5" data-dy="3" />
      <Image class="hero__tech hero__tech--sat hero__tech--sat--dia" src={sateliteDia} alt="" width={144} height={144} decoding="async" data-dx="10" data-dy="5" />
      <Image class="hero__tech hero__tech--sat hero__tech--sat--noche" src={sateliteNoche} alt="" width={144} height={144} decoding="async" loading="lazy" data-dx="10" data-dy="5" />
      <Image class="hero__tech hero__tech--tower hero__tech--tower--dia" src={torreDia} alt="" width={80} height={140} decoding="async" data-dx="7" data-dy="4" />
      <Image class="hero__tech hero__tech--tower hero__tech--tower--noche" src={torreNoche} alt="" width={80} height={140} decoding="async" loading="lazy" data-dx="7" data-dy="4" />

      <!-- z1 · campo (día y noche, se cruzan con opacity) -->
      <Image class="hero__field hero__field--dia" src={campoImg} alt="" width={1920} height={240} loading="eager" decoding="async" data-dx="14" data-dy="2" />
      <Image class="hero__field hero__field--noche" src={campoNocheImg} alt="" width={1920} height={240} decoding="async" loading="lazy" data-dx="14" data-dy="2" />

      <div class="hero__inner">
        <div class="hero__copy">
          <span class="badge">Software a medida</span>
          <h1>Hacemos eficiente <em>tu flujo de trabajo.</em></h1>
          <p class="lead">Reducimos costos, agilizamos procesos y automatizamos lo aburrido. Enfocate en lo que hacés bien, nosotros nos encargamos de que la tecnología te acompañe, no que te frene.</p>
          <div class="cta">
            <a class="btn btn--primary" href="#contacto">Empezar Ahora
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <a class="btn btn--ghost" href="#servicios">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>Ver Servicios</a>
          </div>
        </div>

        <div class="hero__art">
          <div class="hero__figure">
            <!-- z0 · cielo: wrapper con parallax; adentro sol y luna -->
            <div class="hero__sky" data-dx="8" data-dy="5">
              <Image class="hero__sun" src={solImg} alt="" width={414} height={416} loading="eager" fetchpriority="high" decoding="async" />
              <Image class="hero__moon" src={lunaImg} alt="" width={414} height={416} decoding="async" loading="lazy" />
            </div>
            <!-- z2 · gaucho: LCP -->
            <Image class="hero__gaucho" src={gauchoImg} alt="Gaucho tomando mate" width={288} height={455} loading="eager" fetchpriority="high" data-dx="20" data-dy="2" />
          </div>
        </div>
      </div>

      <!-- TECH · dron (z2) sobre el campo, a la derecha del gaucho -->
      <Image class="hero__tech hero__tech--dron hero__tech--dron--dia" src={dronDia} alt="" width={144} height={144} decoding="async" data-dx="22" data-dy="3" />
      <Image class="hero__tech hero__tech--dron hero__tech--dron--noche" src={dronNoche} alt="" width={144} height={144} decoding="async" loading="lazy" data-dx="22" data-dy="3" />

      <!-- z3 · primer plano + luciérnagas -->
      <Image class="hero__front hero__front--dia" src={primerPlanoImg} alt="" width={1920} height={240} decoding="async" data-dx="30" data-dy="3" />
      <Image class="hero__front hero__front--noche" src={primerPlanoNocheImg} alt="" width={1920} height={240} decoding="async" loading="lazy" data-dx="30" data-dy="3" />
      <div class="hero__flies" id="flies" aria-hidden="true" data-dx="24" data-dy="3"></div>
    </header>
    <section id="filosofia" class="py-24 bg-white dark:bg-white/5 relative overflow-hidden snap-start">
      <div class="absolute inset-0 overflow-clip">
        <div class="absolute top-0 right-0 w-64 h-64 bg-brand-verde/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      </div>
      <div class="max-w-7xl mx-auto px-6 relative z-10 overflow-clip">
        <div class="text-center mb-16">
          <span class="text-brand-verde-profundo font-bold tracking-widest uppercase text-sm mb-2 block">Identidad & Propósito</span>
          <h2 class="text-4xl font-display font-bold text-brand-dark dark:text-brand-crema">Nuestra Brújula</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-12 mb-20">
          <div class="p-8 rounded-3xl bg-brand-crema dark:bg-white/10 border border-brand-verde-profundo/5 dark:border-white/10 relative group hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-white dark:bg-white/15 rounded-xl shadow-sm flex items-center justify-center text-brand-verde mb-6">
              <svg class="icon text-3xl" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-rocket_launch"/></svg>
            </div>
            <h3 class="text-2xl font-bold mb-4 font-display">Nuestra Misión</h3>
            <p class="text-brand-verde-profundo/80 dark:text-brand-crema/75 leading-relaxed">Queremos que los negocios de nuestra región puedan competir de igual a igual. Hacemos que la tecnología sea una herramienta de crecimiento, no un dolor de cabeza, ayudándote a <strong>vender más y trabajar mejor</strong>.</p>
          </div>
          <div class="p-8 rounded-3xl bg-brand-crema dark:bg-white/10 border border-brand-verde-profundo/5 dark:border-white/10 relative group hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-white dark:bg-white/15 rounded-xl shadow-sm flex items-center justify-center text-brand-verde-profundo dark:text-brand-crema mb-6">
              <svg class="icon text-3xl" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-visibility"/></svg>
            </div>
            <h3 class="text-2xl font-bold mb-4 font-display">Nuestra Visión</h3>
            <p class="text-brand-verde-profundo/80 dark:text-brand-crema/75 leading-relaxed">Ser el socio tecnológico de confianza para emprendedores y PyMEs. En 5 años, imaginamos un ecosistema local digitalizado, eficiente y conectado al mundo, impulsado por soluciones creadas acá, por gente de acá.</p>
          </div>
        </div>
        <div class="flex flex-col lg:flex-row gap-12 items-center mb-10">
          <div class="flex-1">
            <h3 class="text-2xl font-bold font-display mb-8 text-center lg:text-left">Pilares del Fogón</h3>
            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 bg-brand-crema dark:bg-white/10 border border-brand-verde-profundo/5 dark:border-white/10 rounded-2xl text-center hover:bg-white dark:hover:bg-white/15 transition-colors group/icon">
                <div class="mb-2 text-brand-verde-profundo dark:text-brand-crema/80 group-hover/icon:text-brand-verde transition-colors">
                  <svg class="icon text-3xl" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-handshake"/></svg>
                </div>
                <h4 class="font-bold text-sm">Cercanía</h4>
              </div>
              <div class="p-4 bg-brand-crema dark:bg-white/10 border border-brand-verde-profundo/5 dark:border-white/10 rounded-2xl text-center hover:bg-white dark:hover:bg-white/15 transition-colors group/icon">
                <div class="mb-2 text-brand-verde-profundo dark:text-brand-crema/80 group-hover/icon:text-brand-verde transition-colors">
                  <svg class="icon text-3xl" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-fact_check"/></svg>
                </div>
                <h4 class="font-bold text-sm">Transparencia</h4>
              </div>
              <div class="p-4 bg-brand-crema dark:bg-white/10 border border-brand-verde-profundo/5 dark:border-white/10 rounded-2xl text-center hover:bg-white dark:hover:bg-white/15 transition-colors group/icon">
                <div class="mb-2 text-brand-verde-profundo dark:text-brand-crema/80 group-hover/icon:text-brand-verde transition-colors">
                  <svg class="icon text-3xl" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-workspace_premium"/></svg>
                </div>
                <h4 class="font-bold text-sm">Calidad</h4>
              </div>
              <div class="p-4 bg-brand-crema dark:bg-white/10 border border-brand-verde-profundo/5 dark:border-white/10 rounded-2xl text-center hover:bg-white dark:hover:bg-white/15 transition-colors group/icon">
                <div class="mb-2 text-brand-verde-profundo dark:text-brand-crema/80 group-hover/icon:text-brand-verde transition-colors">
                  <svg class="icon text-3xl" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-bolt"/></svg>
                </div>
                <h4 class="font-bold text-sm">Simplicidad</h4>
              </div>
            </div>
          </div>
          <div class="flex-1 w-full">
            <div style="background:#1e1e1e" class="rounded-xl shadow-2xl overflow-hidden border border-brand-verde-profundo/10 font-mono text-xs md:text-sm transform rotate-1 hover:rotate-0 transition-transform duration-500 group">
              <div style="background:#252526" class="flex items-center gap-2 px-4 py-3 border-b border-white/5">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
                  <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
                  <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
                </div>
                <span class="ml-4 text-brand-crema/60 italic group-hover:text-brand-verde transition-colors">nuestra_promesa.py</span>
              </div>
              <CodeBlock />
            </div>
          </div>
        </div>
      </div>
    </section>
    <section id="servicios" class="py-24 bg-brand-verde-profundo text-white relative snap-start">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-brand-crema font-bold tracking-widest uppercase text-sm mb-2 block">//
                        Soluciones</span>
          <h2 class="text-4xl font-display font-bold text-white">¿Qué necesitás hoy?</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:bg-white/10 transition-colors group">
            <svg class="icon text-4xl text-brand-verde-300 mb-4 group-hover:scale-110 transition-transform block" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-shopping_cart"/></svg>
            <h3 class="text-xl font-bold mb-2">E-commerce</h3>
            <p class="text-sm text-brand-crema/70">Tiendas online que venden solas. Integración con pagos, envíos
                            y catálogo autogestionable.</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:bg-white/10 transition-colors group">
            <svg class="icon text-4xl text-brand-verde-300 mb-4 group-hover:scale-110 transition-transform block" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-web"/></svg>
            <h3 class="text-xl font-bold mb-2">Sitios Web</h3>
            <p class="text-sm text-brand-crema/70">Landing pages de alto impacto y sitios corporativos optimizados
                            para Google (SEO).</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:bg-white/10 transition-colors group">
            <svg class="icon text-4xl text-brand-verde-300 mb-4 group-hover:scale-110 transition-transform block" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-smart_toy"/></svg>
            <h3 class="text-xl font-bold mb-2">Automatización (SaaS)</h3>
            <p class="text-sm text-brand-crema/70">Sistemas a medida para gestión de turnos, stock o clientes.
                            Ahorrá horas de trabajo manual.</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:bg-white/10 transition-colors group">
            <svg class="icon text-4xl text-brand-verde-300 mb-4 group-hover:scale-110 transition-transform block" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-build"/></svg>
            <h3 class="text-xl font-bold mb-2">Mantenimiento</h3>
            <p class="text-sm text-brand-crema/70">Tu negocio no para, tu web tampoco. Soporte tecnico, actualizaciones y seguridad continua.</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:bg-white/10 transition-colors group">
            <svg class="icon text-4xl text-brand-verde-300 mb-4 group-hover:scale-110 transition-transform block" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-campaign"/></svg>
            <h3 class="text-xl font-bold mb-2">Digitalización</h3>
            <p class="text-sm text-brand-crema/70">Transformamos tus procesos en papel a digital. Llevá tu negocio
                            en el bolsillo.</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:bg-white/10 transition-colors group">
            <svg class="icon text-4xl text-brand-verde-300 mb-4 group-hover:scale-110 transition-transform block" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-school"/></svg>
            <h3 class="text-xl font-bold mb-2">Consultoría</h3>
            <p class="text-sm text-brand-crema/70">Te asesoramos sobre qué tecnología te conviene. No gastes de
                            más en lo que no usás.</p>
          </div>
        </div>
      </div>
    </section>
    <section id="metodologia" class="py-24 bg-brand-crema dark:bg-brand-dark relative snap-start">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
          <div class="lg:w-1/2">
            <span class="text-brand-verde-profundo dark:text-brand-crema font-bold tracking-widest uppercase text-sm mb-2 block">Metodología
                            Ágil</span>
            <h2 class="text-4xl font-display font-bold text-brand-dark dark:text-brand-crema mb-6">Trabajamos con SCRUM</h2>
            <p class="text-lg text-brand-verde-profundo/90 dark:text-brand-crema/85 mb-8">Ordenamos el caos. Usamos metodologías internacionales adaptadas a la realidad local. Entregas semanales, comunicación clara y cero sorpresas.</p>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-verde text-white flex items-center justify-center font-bold flex-shrink-0">1</div>
                <div>
                  <h3 class="font-bold text-brand-dark dark:text-brand-crema">Sprint Semanal</h3>
                  <p class="text-sm text-brand-verde-profundo/70 dark:text-brand-crema/70">Planificamos objetivos cortos. Cada semana ves
                                        avances reales, no promesas.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-verde text-white flex items-center justify-center font-bold flex-shrink-0">2</div>
                <div>
                  <h3 class="font-bold text-brand-dark dark:text-brand-crema">Comunicación Asincrónica</h3>
                  <p class="text-sm text-brand-verde-profundo/70 dark:text-brand-crema/70">Usamos Discord y Notion. Menos reuniones eternas,
                                        más tiempo trabajando en tu proyecto.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-verde text-white flex items-center justify-center font-bold flex-shrink-0">3</div>
                <div>
                  <h3 class="font-bold text-brand-dark dark:text-brand-crema">Transparencia Total</h3>
                  <p class="text-sm text-brand-verde-profundo/70 dark:text-brand-crema/70">Tenés acceso a ver el estado de cada tarea. Nada se
                                        esconde bajo la alfombra.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:w-1/2">
            <div class="bg-white dark:bg-white/5 p-6 rounded-2xl shadow-xl border border-brand-verde-profundo/5 dark:border-white/10 rotate-2">
              <div class="flex justify-between items-center mb-4 border-b pb-2">
                <span class="font-bold text-sm">Proyecto: Tu E-commerce</span>
                <span class="text-xs bg-green-100 text-green-700 dark:bg-brand-verde/20 dark:text-brand-verde-200 px-2 py-1 rounded">Sprint 2</span>
              </div>
              <div class="grid grid-cols-3 gap-2 text-xs">
                <div class="bg-gray-50 dark:bg-white/5 p-2 rounded">
                  <div class="font-bold mb-2 text-brand-verde-profundo dark:text-brand-crema/70">POR HACER</div>
                  <div class="bg-white dark:bg-white/10 p-2 rounded shadow-sm border mb-2">Configurar envíos</div>
                </div>
                <div class="bg-gray-50 dark:bg-white/5 p-2 rounded">
                  <div class="font-bold mb-2 text-brand-verde">EN PROGRESO</div>
                  <div class="bg-white dark:bg-white/10 p-2 rounded shadow-sm border border-l-4 border-l-blue-500 mb-2">Integrar MercadoPago</div>
                  <div class="bg-white dark:bg-white/10 p-2 rounded shadow-sm border border-l-4 border-l-blue-500">Diseño Mobile</div>
                </div>
                <div class="bg-gray-50 dark:bg-white/5 p-2 rounded">
                  <div class="font-bold mb-2 text-brand-verde">HECHO</div>
                  <div class="bg-white dark:bg-white/10 p-2 rounded shadow-sm border border-l-4 border-l-green-500 mb-2 opacity-75 line-through">Inicio</div>
                  <div class="bg-white dark:bg-white/10 p-2 rounded shadow-sm border border-l-4 border-l-green-500 opacity-75 line-through">Hosting</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section id="equipo" class="py-24 bg-brand-verde-profundo/5 dark:bg-white/5 relative snap-start">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <span class="text-brand-verde-profundo dark:text-brand-crema font-bold tracking-widest uppercase text-sm mb-2 block">Quiénes
                    Somos</span>
        <h2 class="text-4xl font-display font-bold text-brand-dark dark:text-brand-crema mb-12">El Fogón Digital</h2>
        <div class="max-w-3xl mx-auto bg-white dark:bg-white/10 p-8 rounded-3xl shadow-xl border border-brand-verde-profundo/5 dark:border-white/10 flex flex-col md:flex-row items-center gap-8 mb-16">
          <div class="relative shrink-0">
            <div class="w-32 h-32 rounded-full ring-4 ring-brand-crema dark:ring-white/20 shadow-lg overflow-hidden">
              <Image src={mateoImg} alt="Mateo Gariboglio" width={128} height={128} loading="lazy" class="w-full h-full object-cover object-top" />
            </div>
            <span class="absolute bottom-1 right-1 w-8 h-8 bg-white dark:bg-white rounded-full flex items-center justify-center shadow-md text-brand-dark dark:text-brand-dark" title="Backend Developer">
              <svg class="icon text-sm" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-terminal"/></svg>
            </span>
          </div>
          <div class="text-left">
            <h3 class="text-2xl font-bold text-brand-dark dark:text-brand-crema">Mateo Gariboglio</h3>
            <p class="text-blue-600 dark:text-blue-400 font-medium mb-4">Fundador & Scrum Master</p>
            <p class="text-brand-verde-profundo/70 dark:text-brand-crema/70 mb-6 text-sm leading-relaxed">"Me obsesiona que las cosas funcionen bien. Mi rol es coordinar que todo el engranaje tecnico gire perfecto para que vos solo te preocupes por vender. Vengo del Backend (Java/Spring), asi que la robustez es mi prioridad."</p>
            <div class="flex gap-4">
              <a href="https://www.linkedin.com/in/mateo-gariboglio/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Mateo Gariboglio" class="text-brand-verde-profundo/60 dark:text-brand-crema/50 dark:text-brand-crema/60 hover:text-[#0077b5] transition-colors"><svg class="icon" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-work"/></svg></a>
              <a href="https://github.com/Mateo-404" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Mateo Gariboglio" class="text-brand-verde-profundo/60 dark:text-brand-crema/50 dark:text-brand-crema/60 hover:text-black dark:hover:text-white transition-colors"><svg class="icon" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-code"/></svg></a>
            </div>
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-8 text-left max-w-4xl mx-auto">
          <div class="p-6 bg-brand-verde-profundo text-white rounded-2xl">
            <h4 class="font-bold text-lg mb-2 flex items-center gap-2">
              <svg class="icon text-brand-verde" aria-hidden="true" focusable="false" width="1em" height="1em"><use href="#i-group_add"/></svg>
              Red de Talentos
            </h4>
            <p class="text-sm opacity-80">No perdemos tiempo en procesos lentos. Formamos equipos de especialistas seleccionados según la complejidad de tu proyecto. Ingeniería directa, honesta y enfocada en resultados.</p>
          </div>
          <div class="p-6 bg-white dark:bg-white/10 border border-brand-verde-profundo/10 dark:border-white/10 rounded-2xl">
            <h4 class="font-bold text-lg mb-2 flex items-center gap-2 text-brand-dark dark:text-brand-crema">
