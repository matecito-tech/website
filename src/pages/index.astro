---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Logo from '../components/Logo.astro';
import { Image } from 'astro:assets';
import { PLANS, SITE_URL, whatsappLink } from '../data/site';
import mateoImg from '../assets/mateo-gariboglio-busto.webp';
import casoEscritorio from '../assets/caso-schalbetter-escritorio.webp';
import casoCelular from '../assets/caso-schalbetter-celular.webp';
import gauchoImg from '../assets/hero/gaucho.svg';
import solImg from '../assets/hero/sol.svg';
import lunaImg from '../assets/hero/luna.svg';
import campoImg from '../assets/hero/tech/campo-tech.svg';
import campoNocheImg from '../assets/hero/tech/campo-tech-noche.svg';
import primerPlanoImg from '../assets/hero/primer-plano.svg';
import primerPlanoNocheImg from '../assets/hero/primer-plano-noche.svg';
import redNodosDia from '../assets/hero/tech/red-nodos-dia.svg';
import redNodosNoche from '../assets/hero/tech/red-nodos-noche.svg';
import sateliteDia from '../assets/hero/tech/satelite-dia.svg';
import sateliteNoche from '../assets/hero/tech/satelite-noche.svg';
import dronDia from '../assets/hero/tech/dron-dia.svg';
import dronNoche from '../assets/hero/tech/dron-noche.svg';

const SITE = SITE_URL;

const servicios = [
  { icon: 'web', title: 'Páginas web', desde: 'USD 250', text: 'Tu negocio en Google con un sitio rápido, que se ve bien en el celular y lleva las consultas directo a tu WhatsApp.' },
  { icon: 'shopping_cart', title: 'Tiendas online', desde: 'USD 550', text: 'Vendé las 24 horas con catálogo autogestionable, cobros con Mercado Pago y envíos integrados. En Tiendanube, WooCommerce o a medida, según tu presupuesto.' },
  { icon: 'smart_toy', title: 'Sistemas a medida', desde: 'USD 350', text: 'Turnos, stock, clientes o facturación en un sistema hecho para tu forma de trabajar. Menos planillas, menos errores.' },
  { icon: 'campaign', title: 'Digitalización', desde: null, text: 'Pasamos tus procesos en papel a herramientas digitales para que tengas el negocio en el bolsillo.' },
  { icon: 'build', title: 'Mantenimiento', desde: 'USD 50/mes', text: 'Actualizaciones, copias de seguridad y soporte técnico para que tu sitio nunca se quede atrás.' },
  { icon: 'school', title: 'Consultoría', desde: null, text: 'Te ayudamos a elegir qué tecnología te conviene antes de invertir, para que no pagues por lo que no vas a usar.' },
];

const pasos = [
  { title: 'Nos contás tu idea', text: 'Por el formulario o WhatsApp. Te hacemos las preguntas justas para entender tu negocio.' },
  { title: 'Recibís una propuesta', text: 'Alcance, plazo y precio por escrito. Sin letra chica y sin cargo.' },
  { title: 'Ves avances cada semana', text: 'Trabajamos en sprints semanales y tenés acceso al tablero con el estado de cada tarea.' },
  { title: 'Lanzamos y te acompañamos', text: 'Publicamos, te enseñamos a usarlo y quedamos a mano para lo que necesites.' },
];

const planes = PLANS.map((p) => ({ ...p, price: String(p.usd) }));

const faqs = [
  { q: '¿Qué es Matecito Tech?', a: 'Matecito Tech es un estudio de desarrollo de software de Humboldt, Santa Fe, fundado por Mateo Gariboglio. Hacemos páginas web, tiendas online y sistemas a medida para pymes y emprendedores de la región y del resto del país.' },
  { q: '¿Cuánto cuesta una página web?', a: 'Una página web arranca en USD 250, una tienda online en USD 550 y un sistema a medida en USD 350. El precio final depende de lo que necesites; el presupuesto es sin cargo y te lo pasamos por escrito antes de empezar.' },
  { q: '¿Cuánto tarda en estar lista?', a: 'Depende del alcance. En la propuesta te damos un plazo concreto y, como trabajamos en sprints semanales, cada semana ves avances reales en vez de esperar hasta el final.' },
  { q: '¿La tienda online es en Tiendanube o a medida?', a: 'Depende de tu presupuesto y de cuánto quieras crecer. Armamos tiendas en Tiendanube o WooCommerce, que son rápidas de lanzar, o una tienda a medida cuando necesitás algo propio. Te recomendamos la opción que más te conviene, no la más cara.' },
  { q: '¿Trabajan solo en Humboldt?', a: 'No. Estamos en Humboldt y trabajamos con negocios de Rafaela, Esperanza, Santa Fe y toda la región, y también con clientes de otras provincias y del exterior. Todo el proceso se puede hacer a distancia.' },
  { q: '¿Qué pasa después de publicar el sitio?', a: 'Te enseñamos a usarlo y te acompañamos en la puesta en marcha. Si querés despreocuparte, el plan de mantenimiento (USD 50 por mes) cubre actualizaciones, seguridad, copias de seguridad y cambios menores.' },
  { q: '¿Puedo ver cómo avanza mi proyecto?', a: 'Sí. Tenés acceso al tablero del proyecto con el estado de cada tarea y recibís entregas semanales. Nada queda escondido.' },
];

const schema = [
  {
    '@type': 'OfferCatalog',
    '@id': `${SITE}/#servicios`,
    name: 'Servicios de Matecito Tech',
    itemListElement: planes.map((p) => ({
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: p.price,
      ...(p.id === 'mantenimiento'
        ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: p.price, priceCurrency: 'USD', unitText: 'MONTH' } }
        : {}),
      itemOffered: { '@type': 'Service', name: p.name, description: p.fit, provider: { '@id': `${SITE}/#organizacion` }, areaServed: 'AR' },
    })),
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE}/#preguntas`,
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout
  title="Matecito Tech | Páginas web y software a medida en Humboldt, Santa Fe"
  description="Matecito Tech: páginas web, tiendas online y sistemas a medida para pymes de Humboldt, Rafaela, Esperanza y Santa Fe. Precios desde USD 250 y presupuesto sin cargo."
  schema={schema}
>
  <!-- ================= HERO ================= -->
  <section class="hero" id="inicio" aria-labelledby="hero-titulo">
    <div class="hero__dust" id="dust" aria-hidden="true" data-dx="8" data-dy="5"><div class="shoot"></div></div>
    <div class="crux" id="crux" aria-hidden="true" data-dx="8" data-dy="5"></div>

    <!-- Nubes y pájaros (de día), detrás de todo -->
    <div class="hero__clouds" aria-hidden="true" data-dx="6" data-dy="3">
      <span class="cloud cloud--1"></span><span class="cloud cloud--2"></span><span class="cloud cloud--3"></span>
    </div>
    <svg class="hero__birds" aria-hidden="true" viewBox="0 0 120 40" data-dx="12" data-dy="6"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path class="bird" d="M4 20q6-7 12 0q6-7 12 0"/><path class="bird b2" d="M40 8q5-6 10 0q5-6 10 0"/><path class="bird b3" d="M70 26q4-5 8 0q4-5 8 0"/></g></svg>

    <!-- Red de nodos: fondo lejano, queda DETRÁS del sol -->
    <Image class="hero__net hero__net--dia" src={redNodosDia} alt="" width={900} height={340} decoding="async" data-dx="10" data-dy="6" />
    <Image class="hero__net hero__net--noche" src={redNodosNoche} alt="" width={900} height={340} decoding="async" loading="lazy" data-dx="10" data-dy="6" />

    <Image class="hero__field hero__field--dia" src={campoImg} alt="" width={1920} height={240} loading="eager" decoding="async" data-dx="24" data-dy="5" />
    <Image class="hero__field hero__field--noche" src={campoNocheImg} alt="" width={1920} height={240} decoding="async" loading="lazy" data-dx="24" data-dy="5" />

    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__kicker"><Logo class="h-5 w-auto" /> Matecito Tech, desde Humboldt, Santa Fe</p>
        <h1 id="hero-titulo">Software a medida que le ahorra horas a tu negocio.</h1>
        <p class="hero__lead">Hacemos páginas web, tiendas online y sistemas de gestión para pymes y emprendedores. Automatizamos lo repetitivo para que vos te dediques a lo que hacés bien.</p>
        <div class="hero__cta">
          <a class="btn-cta btn-lg" href="#contacto">Pedí tu presupuesto sin cargo</a>
          <a class="btn-alt btn-lg" href="#casos">Ver un proyecto real</a>
        </div>
        <ul class="hero__proof">
          <li><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check"/></svg>Precios publicados, desde USD 250</li>
          <li><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check"/></svg>Avances visibles cada semana</li>
          <li><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check"/></svg>El dominio y el sitio son tuyos</li>
        </ul>
        <p class="hero__legal"><a href="/arrepentimiento/">Botón de arrepentimiento</a></p>
      </div>

      <div class="hero__art">
        <div class="hero__figure">
          <!-- z0 · cielo -->
          <div class="hero__far" aria-hidden="true">
            <div class="hero__sky" data-dx="14" data-dy="9">
              <Image class="hero__sun" src={solImg} alt="" width={414} height={416} loading="eager" decoding="async" />
              <Image class="hero__moon" src={lunaImg} alt="" width={414} height={416} decoding="async" loading="lazy" />
            </div>
          </div>
          <!-- z1 · detalles tech: entre el cielo y el gaucho, NUNCA encima de él -->
          <div class="hero__orbit" aria-hidden="true" data-dx="18" data-dy="10">
            <Image class="hero__sat hero__sat--dia" src={sateliteDia} alt="" width={144} height={144} decoding="async" />
            <Image class="hero__sat hero__sat--noche" src={sateliteNoche} alt="" width={144} height={144} decoding="async" loading="lazy" />
          </div>
          <div class="hero__drone" aria-hidden="true" data-dx="30" data-dy="12">
            <Image class="hero__dron hero__dron--dia" src={dronDia} alt="" width={144} height={144} decoding="async" />
            <Image class="hero__dron hero__dron--noche" src={dronNoche} alt="" width={144} height={144} decoding="async" loading="lazy" />
          </div>
          <!-- z2 · gaucho (LCP) -->
          <div class="hero__body">
            <Image class="hero__gaucho" id="gaucho" src={gauchoImg} alt="" width={288} height={455} loading="eager" fetchpriority="high" data-dx="36" data-dy="8" />
            <button type="button" class="cebar" data-cebar aria-label="Cebarle un mate al gaucho (suma a la ronda de mate)"></button>
          </div>
        </div>
      </div>
    </div>

    <Image class="hero__front hero__front--dia" src={primerPlanoImg} alt="" width={1920} height={240} decoding="async" data-dx="56" data-dy="10" />
    <Image class="hero__front hero__front--noche" src={primerPlanoNocheImg} alt="" width={1920} height={240} decoding="async" loading="lazy" data-dx="56" data-dy="10" />
    <div class="hero__flies" id="flies" aria-hidden="true" data-dx="44" data-dy="9"></div>

    <a class="hero__scroll" href="#historia">Seguí bajando<svg class="icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </section>

  <!-- ================= HISTORIA (StoryBrand: el cliente es el héroe, Matecito el guía) ================= -->
  <section id="historia" class="section section--screen story bg-[var(--surface)]" aria-labelledby="historia-titulo">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div class="lg:sticky lg:top-32 self-start reveal">
        <p class="kicker">Una historia que seguro conocés</p>
        <h2 id="historia-titulo" class="h2 mb-6">Son las once de la noche y seguís respondiendo mensajes</h2>
        <p class="lede">Tu negocio funciona. El problema es todo lo que pasa alrededor.</p>
      </div>
      <ol class="chapters">
        <li class="chapter reveal">
          <p class="chapter__tag">El problema</p>
          <p class="chapter__text">Los pedidos llegan por WhatsApp, Instagram y el teléfono. El stock vive en una planilla que solo entendés vos. Cada consulta la respondés a mano, y la que se te pasa termina comprándole a la competencia.</p>
        </li>
        <li class="chapter reveal">
          <p class="chapter__tag">El guía</p>
          <p class="chapter__text">Matecito nació en Humboldt con una idea simple, compartida alrededor de un mate: que los comercios y emprendedores de la región puedan competir de igual a igual con las grandes empresas. Somos ingenieros de software, pero te hablamos en criollo.</p>
        </li>
        <li class="chapter reveal">
          <p class="chapter__tag">El plan</p>
          <p class="chapter__text">Nos contás cómo trabajás, te pasamos alcance, plazo y precio por escrito, y cada semana ves avances reales. Sin tecnicismos y sin sorpresas en la factura.</p>
        </li>
        <li class="chapter chapter--end reveal">
          <p class="chapter__tag">El final</p>
          <p class="chapter__text">Tus clientes encuentran lo que buscan, consultan o compran solos, y los pedidos llegan ordenados. Vos volvés a cerrar el local a la hora de cerrar.</p>
          <a href="#contacto" class="btn-cta mt-6">Quiero ese final</a>
        </li>
      </ol>
    </div>
  </section>

  <!-- ================= SERVICIOS ================= -->
  <section id="servicios" class="section section--screen" aria-labelledby="servicios-titulo">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div class="lg:sticky lg:top-32 self-start reveal">
        <p class="kicker">Servicios</p>
        <h2 id="servicios-titulo" class="h2 mb-6">Lo que podemos hacer por tu negocio</h2>
        <p class="lede mb-8">Desde tu primera página web hasta el sistema que ordena el día a día. Siempre con un precio claro de entrada y alguien que te responde.</p>
        <a href="#precios" class="btn-alt">Ver precios</a>
      </div>
      <ul class="services reveal-stagger">
        {servicios.map((s) => (
          <li class="service">
            <svg class="icon service__icon" aria-hidden="true" focusable="false"><use href={`#i-${s.icon}`}/></svg>
            <div>
              <h3 class="service__title">{s.title}</h3>
              <p class="service__text">{s.text}</p>
            </div>
            {s.desde && <p class="service__price"><span class="sr-only">Precio </span>desde {s.desde}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= CASO REAL ================= -->
  <section id="casos" class="section section--screen case" aria-labelledby="casos-titulo">
    <div class="wrap">
      <div class="case__head">
        <div class="reveal">
          <p class="kicker">Caso real</p>
          <h2 id="casos-titulo" class="h2">De depender de las redes a tener un sitio propio</h2>
        </div>
        <div class="reveal">
          <p class="case__lede">Schalbetter Transportes es una empresa familiar de San Martín de las Escobas que arrancó con un solo camión y hoy cruza fronteras.</p>
          <dl class="case__facts">
            <div><dt>Desde</dt><dd data-count="2004" data-count-from="1990">2004</dd></div>
            <div><dt>Países</dt><dd data-count="4">4</dd></div>
            <div><dt>Para cotizar</dt><dd>1 toque</dd></div>
          </dl>
        </div>
      </div>

      <figure class="case__stage reveal">
        <div class="device-browser">
          <div class="device-browser__bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <p><svg class="icon" viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>schalbettertransportes.com.ar</p>
          </div>
          <Image src={casoEscritorio} alt="Página de inicio del sitio de Schalbetter Transportes en una computadora: camiones en la ruta y el botón Solicitá tu cotización" widths={[800, 1200, 1800, 2560]} sizes="(min-width: 1216px) 1000px, 86vw" loading="lazy" decoding="async" />
        </div>
        <div class="device-phone">
          <Image src={casoCelular} alt="El mismo sitio en un celular, con el botón de WhatsApp siempre a mano" widths={[390, 780, 1170]} sizes="(min-width: 1024px) 232px, 30vw" loading="lazy" decoding="async" />
        </div>
        <figcaption class="sr-only">Capturas del sitio en vivo de Schalbetter Transportes, en computadora y en celular.</figcaption>
      </figure>

      <div class="case__compare reveal-stagger">
        <div class="case__card case__card--before">
          <h3 class="case__h">Antes</h3>
          <ul class="case__list">
            <li>Sin sitio web: todo pasaba por Instagram y Facebook.</li>
            <li>La información de la empresa, repartida y difícil de encontrar.</li>
            <li>Pedidos de cotización llegando desordenados.</li>
          </ul>
        </div>
        <div class="case__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div class="case__card case__card--after">
          <h3 class="case__h">Después</h3>
          <ul class="case__list">
            <li>Sitio propio con su historia, servicios y dominio.</li>
            <li>Cotización por WhatsApp con el mensaje ya escrito.</li>
            <li>Sección para que se postulen choferes.</li>
            <li>SEO base e imágenes optimizadas.</li>
          </ul>
        </div>
      </div>

      <div class="case__cta reveal">
        <a href="https://schalbettertransportes.com.ar/" target="_blank" rel="noopener" class="btn-cta btn-lg">Ver el sitio en vivo <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-open_in_new"/></svg></a>
        <a href="https://github.com/matecito-tech/SchalbetterTransportes" target="_blank" rel="noopener" class="btn-alt btn-lg">Ver el código</a>
        <p class="case__note">Textos y fotos aportados por la empresa.</p>
      </div>
    </div>
  </section>

  <!-- ================= PROCESO ================= -->
  <section id="proceso" class="section section--screen" aria-labelledby="proceso-titulo">
    <div class="wrap">
      <div class="max-w-3xl mb-14 reveal">
        <p class="kicker">Cómo trabajamos</p>
        <h2 id="proceso-titulo" class="h2 mb-6">De la idea al lanzamiento, sin sorpresas</h2>
        <p class="lede">Usamos Scrum adaptado a negocios de acá: objetivos cortos, comunicación por escrito y todo a la vista. Menos reuniones eternas, más avance.</p>
      </div>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] items-center">
        <ol class="steps reveal-stagger">
          {pasos.map((p, i) => (
            <li class="step">
              <span class="step__n" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="step__title">{p.title}</h3>
                <p class="step__text">{p.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="board reveal" aria-label="Ejemplo de tablero de un proyecto" role="img" data-board>
          <div class="board__head">
            <span class="font-bold">Proyecto: tu tienda online</span>
            <span class="board__tag">Semana 2</span>
          </div>
          <div class="board__cols">
            <div data-board-col="todo"><p class="board__col">Por hacer</p><p class="board__card">Configurar envíos</p></div>
            <div data-board-col="doing"><p class="board__col">En curso</p><p class="board__card board__card--doing">Integrar Mercado Pago</p><p class="board__card board__card--doing">Diseño para celular</p></div>
            <div data-board-col="done"><p class="board__col">Listo</p><p class="board__card board__card--done">Dominio</p><p class="board__card board__card--done">Hosting</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PRECIOS ================= -->
  <section id="precios" class="section section--screen bg-[var(--surface)]" aria-labelledby="precios-titulo">
    <div class="wrap">
      <div class="max-w-3xl mb-14 reveal">
        <p class="kicker">Precios</p>
        <h2 id="precios-titulo" class="h2 mb-6">Precios claros desde el primer día</h2>
        <p class="lede">Sabés cuánto arranca cada servicio antes de hablar con nadie. El presupuesto final depende de lo que necesites y siempre es sin cargo.</p>
      </div>
      <ul class="plans reveal-stagger">
        {planes.map((p) => (
          <li class="plan">
            <h3 class="plan__name">{p.name}</h3>
            <p class="plan__price"><span class="plan__cur">USD</span> <span data-count={p.price}>{p.price}</span></p>
            <p class="plan__unit">{p.unit}</p>
            <p class="plan__ars" data-ars-usd={p.usd} data-ars-mes={p.id === 'mantenimiento' ? '1' : undefined}></p>
            <p class="plan__fit">{p.fit}</p>
            <ul class="plan__items">
              {p.items.map((it) => <li><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check"/></svg>{it}</li>)}
            </ul>
            <a href="#contacto" class="btn-alt w-full justify-center mt-auto" data-servicio={p.id}>Consultar por {p.name.toLowerCase()}</a>
          </li>
        ))}
      </ul>
      <p class="sm:hidden text-sm text-[var(--ink-2)] -mt-2 mb-4" aria-hidden="true">Deslizá para ver los cuatro planes →</p>
      <p class="text-sm text-[var(--ink-2)] mt-8 max-w-3xl">Valores de referencia en dólares estadounidenses, con su equivalente aproximado en pesos al dólar oficial del día. El precio final en pesos, con impuestos incluidos, figura en el presupuesto escrito.</p>
    </div>
  </section>

  <!-- ================= NOSOTROS ================= -->
  <section id="nosotros" class="section section--screen" aria-labelledby="nosotros-titulo">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-20 items-center">
      <div class="reveal">
        <p class="kicker">Nosotros</p>
        <h2 id="nosotros-titulo" class="h2 mb-6">Ingeniería de software con raíces santafesinas</h2>
        <p class="lede mb-8">Queremos que los negocios de la región compitan de igual a igual. Por eso hacemos que la tecnología sea una herramienta para vender más y trabajar mejor, no un dolor de cabeza.</p>

        <figure class="founder">
          <div class="founder__art">
            <Image src={mateoImg} alt="Ilustración de Mateo Gariboglio, fundador de Matecito Tech" width={225} height={315} densities={[1, 2]} loading="lazy" decoding="async" class="founder__img" />
          </div>
          <blockquote class="founder__quote">“Me obsesiona que las cosas funcionen bien. Mi rol es que todo el engranaje técnico gire perfecto para que vos solo te preocupes por vender.”</blockquote>
          <figcaption class="founder__cap">
            <strong class="block text-base">Mateo Gariboglio</strong>
            <span class="text-[var(--ink-2)]">Fundador y Scrum Master. Viene del backend (Java y Spring).</span>
            <span class="flex gap-4 mt-2">
              <a class="underline underline-offset-4 hover:text-brand-verde" href="https://www.linkedin.com/in/mateo-gariboglio/" target="_blank" rel="noopener">LinkedIn</a>
              <a class="underline underline-offset-4 hover:text-brand-verde" href="https://github.com/Mateo-404" target="_blank" rel="noopener">GitHub</a>
