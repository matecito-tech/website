<style is:global>
  
  :root {
    --bg: var(--color-brand-crema);
    --ink: var(--color-brand-dark);
    --ink-soft: var(--color-brand-verde-profundo);
    --green: var(--color-brand-verde);
    --line: var(--color-border);
    --badge-bg: color-mix(in srgb, var(--color-brand-verde) 10%, transparent); --badge-line: color-mix(in srgb, var(--color-brand-verde) 20%, transparent); --badge-ink: var(--color-brand-verde);
    --btn-bg: var(--color-brand-dark); --btn-ink: #fff;
    --ghost-bg: #fff;
    --halo: rgba(249,188,61,.16);
    --maxw: 75rem;
    --gutter: clamp(1.25rem, 4vw, 2rem);
    --gap: clamp(1rem, 3vw, 3rem);
    --field-h: clamp(120px, 12.5vw, 340px);
    --lift: calc(var(--field-h) * .13);
    --bleed: calc(var(--field-h) * .03);   /* sobrante inferior del campo: cubre el movimiento vertical del parallax */
    --pad: 40px;                           /* sobrante lateral del campo: cubre el movimiento horizontal */
  }
  :root.dark {
    --bg: var(--color-brand-dark);
    --ink: var(--color-brand-crema);
    --ink-soft: var(--color-brand-crema);
    --green: var(--color-brand-verde);
    --line: color-mix(in srgb, var(--color-brand-crema) 16%, transparent);
    --badge-bg: color-mix(in srgb, var(--color-brand-verde) 12%, transparent); --badge-line: color-mix(in srgb, var(--color-brand-verde) 35%, transparent); --badge-ink: var(--color-brand-verde);
    --btn-bg: var(--color-brand-crema); --btn-ink: var(--color-brand-dark);
    --ghost-bg: transparent;
    --halo: rgba(170,196,255,.14);
  }



  /* ---------- Hero ---------- */
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    container-type: inline-size;
    display: flex;
    min-height: min(100svh, 57.5rem);
    background: var(--bg);
    transition: background-color .6s ease;
  }

  /* Campo y primer plano: más anchos que la ventana (overscan) para que el parallax no muestre bordes */
  .hero__field, .hero__front {
    position: absolute;
    left: calc(var(--pad) * -1); right: calc(var(--pad) * -1);
    bottom: calc(var(--bleed) * -1);
    width: calc(100% + var(--pad) * 2); max-width: none;
    height: calc(var(--field-h) + var(--bleed));
    object-fit: cover; object-position: 50% 100%;
    pointer-events: none; user-select: none;
    transition: opacity .7s ease;
  }
  .hero__field { z-index: 1; }
  .hero__front { z-index: 3; }
  .hero__field--noche, .hero__front--noche { opacity: 0; }
  :root.dark .hero__field--noche, :root.dark .hero__front--noche { opacity: 1; }
  :root.dark .hero__field--dia,   :root.dark .hero__front--dia   { opacity: 0; }

  .hero__inner {
    position: relative; flex: 0 1 auto;
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); column-gap: var(--gap);
  }

  .hero__copy { position: relative; z-index: 4; align-self: center; max-width: 36rem;
                padding-block: clamp(4.5rem, 11vh, 7rem) calc(var(--field-h) * .5 + 2rem); }

  .badge { display: inline-flex; align-items: center; gap: .5rem; padding: .4rem .85rem; border-radius: 999px;
           background: var(--badge-bg); border: 1px solid var(--badge-line); color: var(--badge-ink);
           font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; transition: all .6s ease; }
  .badge::before { content: ""; width: .4rem; height: .4rem; border-radius: 50%; background: currentColor; }

  h1 { margin: 1.25rem 0 1.5rem; font-size: clamp(2.5rem, 5.2vw, 4.4rem); line-height: 1.04; letter-spacing: -.02em; font-weight: 800; text-wrap: balance; }
  h1 em { display: block; font-style: normal; color: var(--green); transition: color .6s ease; }
  .lead { margin: 0 0 2.25rem; max-width: 34rem; font-size: clamp(1rem, 1.25vw, 1.125rem); line-height: 1.8; color: var(--ink-soft); }

  .cta { display: flex; flex-wrap: wrap; gap: 1rem; }
  .btn { display: inline-flex; align-items: center; gap: .6rem; min-height: 3.25rem; padding: 0 1.9rem; border-radius: .8rem;
         font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; border: 1px solid transparent;
         transition: transform .15s ease, background-color .6s ease, color .6s ease, border-color .6s ease; }
  .btn svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .btn--primary { background: var(--btn-bg); color: var(--btn-ink); box-shadow: 0 10px 24px -10px rgba(0,0,0,.55); }
  .btn--ghost { background: var(--ghost-bg); color: var(--ink-soft); border-color: var(--line); }
  .btn:hover { transform: translateY(-1px); }
  .btn:focus-visible { outline: 3px solid #3BA374; outline-offset: 3px; }

  /* ---------- Arte ---------- */
  .hero__art { position: relative; align-self: end; }   /* SIN z-index ni transform */

  .hero__figure {
    --col: calc((min(100cqw - 2 * var(--gutter), var(--maxw)) - var(--gap)) * .45);
    --h: min(clamp(21rem, 72svh, 42rem), calc(var(--col) * 1.23));
    position: relative; height: var(--h); aspect-ratio: 288 / 455;
    margin-inline: auto; bottom: var(--lift); left: 8%;   /* offsets relativos, NUNCA transform */
  }

  .hero__gaucho { position: relative; z-index: 2; display: block; width: 100%; height: 100%; }

  /* Cielo = sol y luna apilados. El wrapper es el que recibe el parallax; las imágenes solo hacen el "sube/baja" */
  .hero__sky { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero__sky::before {                                  /* halo: gradiente, sin blur ni filtros */
    content: ""; position: absolute; left: 40.5%; top: 52.3%; width: 230%; aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, var(--halo), transparent 72%);
    transition: background .6s ease;
  }
  /* max-width:none es CLAVE: sin esto el reset de Tailwind achica el sol al 100% de la figura y se desalinea */
  .hero__sun, .hero__moon {
    position: absolute; left: -31.25%; top: 5.93%; width: 143.75%; height: auto; max-width: none;
    transition: transform .9s cubic-bezier(.4, 0, .2, 1), opacity .6s ease;
  }
  .hero__moon { opacity: 0; transform: translateY(14%); }
  :root.dark .hero__sun  { opacity: 0; transform: translateY(14%); }   /* el sol se pone */
  :root.dark .hero__moon { opacity: 1; transform: none; }              /* la luna sale */

  /* ---------- Puntitos verdes (día) -> estrellas (noche): MISMOS elementos ---------- */
  .hero__dust { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero__dust i {
    position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s);
    border-radius: 50%; background: #55B27F; opacity: .4;
    transition: background-color .6s ease, opacity .6s ease;
    animation: dust-float var(--t) ease-in-out var(--d) infinite alternate;
  }
  @keyframes dust-float { to { transform: translate3d(0, -10px, 0); } }

  :root.dark .hero__dust i { background: #FFF6DD; opacity: .9; box-shadow: 0 0 6px 1px rgba(255,246,221,.5);
                                           animation: twinkle var(--t) ease-in-out var(--d) infinite; }
  @keyframes twinkle { 0%, 100% { opacity: .22; transform: scale(.75); } 50% { opacity: 1; transform: scale(1.15); } }
  /* las grandes se vuelven destello de 4 puntas */
  :root.dark .hero__dust i.big, :root.dark .crux i {
    width: calc(var(--s) * 3.4); height: calc(var(--s) * 3.4); border-radius: 0; box-shadow: none; background: #fff;
    clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
  }

  /* Cruz del Sur: guiño argentino, solo de noche */
  .crux { position: absolute; z-index: 0; right: 4.5%; top: 11%; width: 60px; height: 110px; opacity: 0; transition: opacity 1s ease .3s; pointer-events: none; }
  :root.dark .crux { opacity: 1; }
  .crux i { position: absolute; border-radius: 50%; background: #fff; width: var(--s); height: var(--s);
            left: var(--x); top: var(--y); animation: twinkle 5s ease-in-out var(--d) infinite; }

  /* Estrella fugaz: una cada ~16 s, solo de noche */
  .shoot { position: absolute; left: 24%; top: 9%; width: 110px; height: 2px; opacity: 0; border-radius: 2px;
           background: linear-gradient(90deg, transparent, #fff); }
  :root.dark .shoot { animation: shoot 16s linear 3s infinite; }
  @keyframes shoot { 0% { opacity: 0; transform: translate(0,0) rotate(24deg); } 1.5% { opacity: 1; }
                     5% { opacity: 0; transform: translate(300px,134px) rotate(24deg); } 100% { opacity: 0; } }

  /* Luciérnagas: solo de noche, sobre el campo */
  .hero__flies { position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--field-h) * 1.15); z-index: 3; pointer-events: none; }
  .hero__flies i { position: absolute; left: var(--x); top: var(--y); width: 5px; height: 5px; border-radius: 50%;
                   background: #E6F985; box-shadow: 0 0 9px 3px rgba(230,249,133,.65); opacity: 0; }
  :root.dark .hero__flies i { animation: fly var(--t) ease-in-out var(--d) infinite; }
  @keyframes fly { 0% { opacity: 0; transform: translate(0,0); } 20%,70% { opacity: .95; }
                   50% { transform: translate(var(--dx), var(--dy)); } 100% { opacity: 0; transform: translate(calc(var(--dx) * 1.6), calc(var(--dy) * .4)); } }

  /* Entrada del sol: fill-mode "backwards" (NO "both"), si no la animación pisa el estado oscuro y el sol nunca se va */
  @media (prefers-reduced-motion: no-preference) {
    .hero__sky { animation: cielo-entra .9s cubic-bezier(.2,.7,.2,1) backwards; }
    @keyframes cielo-entra { from { opacity: 0; } to { opacity: 1; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__dust i, .hero__flies i, .crux i, .shoot { animation: none !important; }
    .hero__sun, .hero__moon, .hero__field, .hero__front { transition: none; }
  }

  /* ---------- Tech (detalles sutiles) ---------- */
  .hero__tech {
    position: absolute;
    max-width: none;
    height: auto;
    pointer-events: none;
    user-select: none;
    transition: opacity .7s ease;
  }
  .hero__tech--net { z-index: 0; left: 47%; top: 2%; width: 53%; }
  .hero__tech--net--noche, .hero__tech--sat--noche, .hero__tech--tower--noche, .hero__tech--dron--noche { opacity: 0; }
  :root.dark .hero__tech--net--noche, :root.dark .hero__tech--sat--noche, :root.dark .hero__tech--tower--noche, :root.dark .hero__tech--dron--noche { opacity: 1; }
  :root.dark .hero__tech--net--dia, :root.dark .hero__tech--sat--dia, :root.dark .hero__tech--tower--dia, :root.dark .hero__tech--dron--dia { opacity: 0; }

  .hero__tech--sat { z-index: 0; left: 63%; top: 8%; width: clamp(54px, 5.6vw, 108px); animation: sat-flota 16s ease-in-out infinite alternate; }
  .hero__tech--tower { z-index: 1; left: 56%; top: 16%; width: clamp(56px, 6vw, 92px); opacity: .9; }
  .hero__tech--dron { z-index: 2; left: 84.5%; top: 47%; width: clamp(60px, 7.2vw, 136px); animation: dron-flota 12s ease-in-out infinite alternate; }

  @keyframes sat-flota { from { transform: rotate(-12deg) translate(0, 0); } to { transform: rotate(-6deg) translate(-1.4cqw, .8cqw); } }
  @keyframes dron-flota { from { transform: translate(0, 0) rotate(-2deg); } to { transform: translate(-1.2cqw, -1cqw) rotate(2deg); } }

  @media (prefers-reduced-motion: reduce) {
    .hero__tech--sat, .hero__tech--dron { animation: none; }
    .hero__tech--sat { transform: rotate(-10deg); }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 859px) {
    .hero { min-height: 0; }
    .hero__inner { grid-template-columns: minmax(0, 1fr); }
    .hero__copy { padding-block: 3.5rem 1.5rem; max-width: none; }
    .hero__figure { --col: calc(100cqw - 2 * var(--gutter)); --h: min(clamp(18rem, 50svh, 30rem), calc(var(--col) * 1.23)); left: 6%; }
    .btn { flex: 1 1 auto; justify-content: center; }
    :root.dark .hero__dust i.big { display: none; }   /* en mobile el texto ocupa todo el ancho */
    .crux { top: 3%; right: 6%; transform: scale(.7); transform-origin: top right; }
    .hero__tech--net, .hero__tech--sat, .hero__tech--tower, .hero__tech--dron { display: none; }
  }

  /* Solo del demo */
  
</style>


<script>
  // ===== generación determinista de puntitos / estrellas / luciérnagas =====
  const rng = (a => () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a);
                            t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; })(20261021);
  const R = (a: number, b: number) => a + rng() * (b - a);
  const dust = document.getElementById('dust');
  if (dust) {
    for (let i = 0; i < 70; i++) {
      const el = document.createElement('i'); const big = i % 7 === 0;
      el.className = big ? 'big' : '';
      let x = R(1,99), y = R(2,80);
      if (big && x < 58 && y > 14) x = R(60,99);
      el.style.cssText = '--x:' + x.toFixed(1) + '%;--y:' + y.toFixed(1) + '%;--s:' + (big ? R(2,3).toFixed(1) : R(2,4.2).toFixed(1)) + 'px;--t:' + R(3,7).toFixed(1) + 's;--d:-' + R(0,7).toFixed(1) + 's';
      dust.appendChild(el);
    }
  }
  const crux = document.getElementById('crux');
  if (crux) {
    [[24,0,2.4],[26,92,3],[0,40,2.2],[50,52,2],[34,70,1.4]].forEach(([x,y,s],i) => {
      const el = document.createElement('i'); el.style.cssText = '--x:' + x + 'px;--y:' + y + 'px;--s:' + s + 'px;--d:-' + (i*1.1) + 's'; crux.appendChild(el);
    });
  }
  const flies = document.getElementById('flies');
  if (flies) {
    for (let i = 0; i < 14; i++) {
      const el = document.createElement('i');
      el.style.cssText = '--x:' + R(2,98).toFixed(1) + '%;--y:' + R(10,80).toFixed(1) + '%;--dx:' + R(-50,50).toFixed(0) + 'px;--dy:' + R(-40,10).toFixed(0) + 'px;--t:' + R(6,11).toFixed(1) + 's;--d:-' + R(0,10).toFixed(1) + 's';
      flies.appendChild(el);
    }
  }

  // ===== parallax con el mouse =====
  const hero = document.getElementById('hero');
  if (hero) {
    const layers = [...hero.querySelectorAll('[data-dx]')].map(el => ({ el: el as HTMLElement, dx: +(el as HTMLElement).dataset.dx, dy: +(el as HTMLElement).dataset.dy }));
    const fine = matchMedia('(hover: hover) and (pointer: fine)'), calm = matchMedia('(prefers-reduced-motion: reduce)');
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
    function tick() {
      cx += (tx - cx) * .08; cy += (ty - cy) * .08;
      const dpr = window.devicePixelRatio || 1, snap = (v: number) => Math.round(v * dpr) / dpr;
      for (const { el, dx, dy } of layers) (el as HTMLElement).style.translate = snap(-cx * dx) + 'px ' + snap(-cy * dy) + 'px';
      raf = (Math.abs(tx - cx) > .002 || Math.abs(ty - cy) > .002) ? requestAnimationFrame(tick) : 0;
    }
    hero.addEventListener('pointermove', e => {
      if (!fine.matches || calm.matches) return;
      const r = hero.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - .5) * 2; ty = ((e.clientY - r.top) / r.height - .5) * 2; kick();
    });
    hero.addEventListener('pointerleave', () => { tx = ty = 0; kick(); });
  }
</script>

</Layout>